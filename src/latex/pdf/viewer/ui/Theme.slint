
export global Theme {
	in-out property <color> window-background: #333333;
	in-out property <color> text-color: #f0f0ff;	
	in-out property <color> button-background: #007acc;
	in-out property <color> button-hover-background: #005a9e;
	in-out property <color> button-disabled-background: #555555;
	in-out property <color> button-disabled-text-color: #888888;
}